# Cosmos DB (required for /name, /sadhana, /bv, /admn)
COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DB=iskcon
ADMN_SESSION_SECRET=
# Sadhana overview admin key is stored on the sadhana table in Cosmos — set/update in /admn only.
# Optional one-time seed for scripts/cleanup-sadhana-person-tabs.ts if table has no adminKey yet:
# SADHANA_ADMIN_KEY=
# Prefer: npx tsx scripts/create-admin.ts --username USER --password PASS --role write|read
